NEUROOPS_MLFLOW_TRACKING_URI=sqlite:///./mlflow.db
NEUROOPS_MLFLOW_REGISTRY_URI=sqlite:///./mlflow.db
NEUROOPS_PREFECT_API_URL=
NEUROOPS_PREFECT_WORKER_HEALTH_URL=
NEUROOPS_PREFECT_EXPERIMENT_DEPLOYMENT="NeuroOps experiment/neuroops-experiments"
NEUROOPS_PREFECT_PREDICTION_DEPLOYMENT="NeuroOps prediction/neuroops-predictions"
